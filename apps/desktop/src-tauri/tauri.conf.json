{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spank",
  "identifier": "dev.spank.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "© 2026 kaija — MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true
    },
    "resources": {
      "../../../assets/sounds/builtin/": "builtin/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NENBQ0VCMzA0RUMzNjEKUldSaHcwNHc2NnhNVjBaellBc1BUTEdVNksrRkIvSWtvNllsbjh4N3VIeU42K2VSMDREdlhBMm4K",
      "endpoints": [
        "https://github.com/kaija/spank/releases/latest/download/latest.json"
      ]
    }
  }
}
