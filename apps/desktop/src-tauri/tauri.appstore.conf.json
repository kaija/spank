{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creaky",
  "build": {
    "beforeBuildCommand": "NEXT_PUBLIC_EDITION=appstore pnpm build"
  },
  "app": {
    "macOSPrivateApi": false
  },
  "bundle": {
    "category": "Entertainment",
    "macOS": {
      "entitlements": "Creaky.appstore.entitlements",
      "files": {
        "embedded.provisionprofile": "../../../signing/Creaky_App_Store.provisionprofile",
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
      }
    }
  }
}
